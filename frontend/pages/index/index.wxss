/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 24rpx;
}

/* 表单 */
.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row .k {
  width: 100rpx;
  color: #666;
  font-size: 28rpx;
}
.inp {
  flex: 1;
  font-size: 28rpx;
  color: #222;
}
.btn {
  margin-top: 24rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.btn-gray {
  background: #eef1f5;
  color: #2563eb;
  margin-top: 16rpx;
}
.saved {
  font-size: 26rpx;
  color: #059669;
  background: #e8f7f0;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

/* 提示 / 错误 */
.hint {
  color: #888;
  font-size: 28rpx;
  padding: 40rpx 0;
  text-align: center;
}
.error {
  color: #c0392b;
  background: #fdecea;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

/* 地址信息卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.k {
  width: 120rpx;
  color: #999;
  flex-shrink: 0;
}
.v {
  flex: 1;
  color: #222;
}

/* 列表项 */
.item {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.item-sub {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 原始返回 */
.raw-title {
  font-size: 26rpx;
  color: #999;
  margin: 32rpx 0 12rpx;
}
.raw {
  font-size: 22rpx;
  background: #0f1723;
  color: #7dd3fc;
  border-radius: 12rpx;
  padding: 24rpx;
  word-break: break-all;
  line-height: 1.6;
}

