/**pages/test/test.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.container {
  padding: 24rpx;
}
.tip {
  background: #eff4ff;
  color: #2563eb;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.btn {
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.raw-title {
  font-size: 26rpx;
  color: #999;
  margin: 32rpx 0 12rpx;
}
.raw {
  font-size: 24rpx;
  background: #0f1723;
  color: #7dd3fc;
  border-radius: 12rpx;
  padding: 24rpx;
  word-break: break-all;
  line-height: 1.6;
  white-space: pre-wrap;
}
